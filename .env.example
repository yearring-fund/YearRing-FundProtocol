# ============================================================
# YearRing Fund Protocol — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ------------------------------------------------------------
# Deployer
# ------------------------------------------------------------

# Private key for deployment / admin scripts.
# Use a dedicated deployer wallet. Do not use a personal main wallet.
PRIVATE_KEY=0x...

# Optional demo persona keys. Testnet / local use only.
ALICE_PRIVATE_KEY=0x...
BOB_PRIVATE_KEY=0x...
CAROL_PRIVATE_KEY=0x...

# ------------------------------------------------------------
# RPC endpoints
# ------------------------------------------------------------

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=
BASE_MAINNET_WSS_URL=

# ------------------------------------------------------------
# Block explorer verification
# ------------------------------------------------------------

BASESCAN_API_KEY=

# ------------------------------------------------------------
# Protocol roles
# ------------------------------------------------------------

ADMIN_ADDRESS=
GUARDIAN_ADDRESS=
TREASURY_ADDRESS=

# ------------------------------------------------------------
# Optional script overrides
# ------------------------------------------------------------

VAULT_ADDRESS=
STRATEGY_MANAGER_ADDRESS=
AAVE_STRATEGY_ADDRESS=

SNAPSHOT_BLOCK=
EPOCH_ID=1
EPOCH_CAP=
